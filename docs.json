{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Developer Docs",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#4338CA"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "authentication", "errors-and-limits"]
          },
          {
            "group": "Webhooks",
            "pages": ["webhooks/overview", "webhooks/verify-signatures", "webhooks/events", "webhooks/manage"]
          },
          {
            "group": "Integrations",
            "pages": ["zapier"]
          }
        ]
      },
      {
        "tab": "Messaging API",
        "openapi": { "source": "api-reference/messaging.openapi.json", "directory": "messaging" }
      },
      {
        "tab": "Publishing API",
        "openapi": { "source": "api-reference/publishing.openapi.json", "directory": "publishing" }
      },
      {
        "tab": "Link in Bio API",
        "groups": [
          {
            "group": "Overview",
            "pages": ["biolinks/overview"]
          },
          {
            "group": "Reference",
            "openapi": { "source": "api-reference/biolinks.openapi.json", "directory": "biolinks" }
          }
        ]
      }
    ]
  },
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "cursor", "vscode"]
  }
}
